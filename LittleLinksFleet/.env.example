# LittleLinks fleet — copy to /etc/littlelinks/fleet.env (chmod 600, root-owned).
#
# The RSA private key is deliberately NOT in this file. Put it in its own
# 0600 file and point LITTLELINKS_FLEET_PRIVATE_KEY_FILE at it, so the key
# that opens Second Life passwords never enters the process environment.

# ── Required ──────────────────────────────────────────────────────────
# Same database the API uses. The fleet reads sealed credentials directly
# because the API cannot decrypt them, by design.
DATABASE_URL=postgres://user:pass@host:5432/lifeline?sslmode=require

# Where the Lifeline API lives. The fleet appends /api/littlelinks/... itself.
LITTLELINKS_API_URL=https://lifelinerp.com

# Must match LITTLELINKS_FLEET_SECRET in the API's environment. Unlike the
# in-world secret there is no open fallback: unset means the fleet endpoints
# are closed, not public.
LITTLELINKS_FLEET_SECRET=change-me-to-a-long-random-string

# Generated by: node tools/generate-fleet-keypair.js ./out
LITTLELINKS_FLEET_PRIVATE_KEY_FILE=/etc/littlelinks/fleet-private.pem

# ── Optional ──────────────────────────────────────────────────────────
# Identifies this worker in littlelinks_bots.claimed_by. Give a second
# worker a different value and it will share the fleet automatically.
FLEET_WORKER_ID=fleet-1

# How many avatars this process drives. Each logged-in avatar costs roughly
# 60-90 MB; 10 is comfortable on a t3.small, 25+ wants a t3.large.
FLEET_CAPACITY=10

# Inventory item the worker wears to give a baby its stats. Matched
# case-insensitively by prefix, so a versioned name still matches.
LITTLELINKS_HUD_ITEM=Lifeline RP Hybrid HUD

# Where a baby logs in when its own start_location is blank.
LITTLELINKS_START_LOCATION=last

# Health endpoint, for the load balancer and for "is the fleet up?".
PORT=3010

# Loop timings, in seconds. The defaults are sane; raise the claim interval
# rather than lowering it if the API is under load.
FLEET_CLAIM_SECONDS=20
FLEET_HEARTBEAT_SECONDS=45
FLEET_COMMAND_SECONDS=3
FLEET_INVENTORY_SECONDS=900
